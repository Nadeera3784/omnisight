# OmniSight backend settings.
# Copy to backend/.env and fill in OPENAI_API_KEY:
#   cp backend/.env.example backend/.env
# docker compose loads backend/.env into the backend and worker containers.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...

# Models. The embedding model must return 1536-dimension vectors (the pgvector column size),
# so keep text-embedding-3-small unless you also change EMBED_DIM and re-index.
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Auth ---
# Secret for signing login tokens. Use a long random string outside local development:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
# How long a login lasts, in hours (168 = 7 days)
JWT_TTL_HOURS=168

# --- Storage (RustFS) ---
S3_BUCKET=omnisight
# Address the browser uses to stream videos and thumbnails via presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- CORS ---
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Connections ---
# docker compose sets these to the db and rustfs containers, overriding anything here.
# Set them only when running the backend outside Docker, e.g.:
# DATABASE_URL=postgresql://omnisight:omnisight@localhost:5432/omnisight
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=rustfsadmin
